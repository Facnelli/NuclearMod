type: ItemTurret
name: silo-misseis
localizedName: Silo de misseis 
description: Silo de mísseis tático de controle manual. Assuma o controle para disparar e não atire perto demais.

size: 4
health: 1200 

category: turret
alwaysUnlocked: true

requirements: [
  copper/100
]

range: 6000
reload: 150
inaccuracy: 2
shootSound: artillery
shootCone: 30

# --- A MÁGICA DO CONTROLE MANUAL ---
# Desativamos a visão da torre. Ela não atirará sozinha em nada.
targetAir: false 
targetGround: false
# Garante que o jogador pode entrar nela para atirar
playerControllable: true 

shoot: {
  shots: 1
}

ammoTypes: {
  uranio-enriquecido: {
    type: ArtilleryBulletType
    
    damage: 20
    speed: 3
    lifetime: 200 
    
    width: 14
    height: 18
    
    trailWidth: 4
    trailLength: 18
    trailColor: ff7a38
    
    splashDamage: 9000
    splashDamageRadius: 100
    
    hitEffect: reactorExplosion
    despawnEffect: reactorExplosion
    hitSound: explosionbig
    hitShake: 50
    
    incendAmount: 30
    incendSpread: 40
    incendChance: 1.0
  }
}